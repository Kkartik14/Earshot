{
  "name": "@earshot/viewer-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.css",
    "!src/**/*.test.*",
    "!src/**/__fixtures__/**",
    "!src/test/**",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./api/hooks": "./src/api/hooks.ts",
    "./api/schema": "./src/api/schema.d.ts",
    "./styles/embedded.css": "./src/styles/embedded.css",
    "./styles/global.css": "./src/styles/global.css",
    "./styles/tokens.css": "./src/styles/tokens.css"
  },
  "scripts": {
    "gen:api": "openapi-typescript ../../spec/backend-api.openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@types/react": "^19.3.0",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "react-router-dom": "^7.18.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.0",
    "react": "^19.3.0"
  }
}
