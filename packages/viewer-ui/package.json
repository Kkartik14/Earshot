{
  "name": "@earshot/viewer-ui",
  "version": "0.2.0",
  "description": "Earshot's React views for voice-agent calls and incidents, with a typed client for the Earshot API.",
  "keywords": [
    "earshot",
    "voice",
    "observability",
    "react"
  ],
  "homepage": "https://github.com/Kkartik14/Earshot/tree/main/packages/viewer-ui#readme",
  "bugs": "https://github.com/Kkartik14/Earshot/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kkartik14/Earshot.git",
    "directory": "packages/viewer-ui"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api/hooks": "./src/api/hooks.ts",
    "./api/schema": "./src/api/schema.d.ts",
    "./styles/embedded.css": "./src/styles/embedded.css",
    "./styles/global.css": "./src/styles/global.css",
    "./styles/tokens.css": "./src/styles/tokens.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./api/hooks": {
        "types": "./dist/api/hooks.d.ts",
        "default": "./dist/api/hooks.js"
      },
      "./api/schema": {
        "types": "./dist/api/schema.d.ts"
      },
      "./styles/embedded.css": "./dist/styles/embedded.css",
      "./styles/global.css": "./dist/styles/global.css",
      "./styles/tokens.css": "./dist/styles/tokens.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node -e \"const fs=require('fs'),path=require('path');fs.cpSync('src','dist',{recursive:true,filter:(s)=>{const b=path.basename(s);return fs.statSync(s).isDirectory()?b!=='test'&&b!=='__fixtures__':b.endsWith('.css')||b==='schema.d.ts'}})\"",
    "gen:api": "openapi-typescript ../../spec/backend-api.openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@types/react": "^19.3.0",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "react-router-dom": "^7.18.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.0",
    "react": "^19.3.0"
  }
}
